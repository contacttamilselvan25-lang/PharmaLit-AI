# PharmaLit AI Configuration
# Optional: Google Gemini API Key for deep LLM-based analysis & research synthesis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: NCBI PubMed API Key (increases rate limit from 3/sec to 10/sec)
PUBMED_API_KEY=
PUBMED_EMAIL=researcher@pharmalit.ai

# Default analysis mode: "auto", "gemini", or "rule_based"
DEFAULT_ANALYSIS_MODE=auto
